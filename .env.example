# 模型层（OpenAI 兼容，可换 Agnes 等）
# 必须用「对话模型」（支持 chat/completions + function calling）。
# 不能用 agnes-video-2.5*（视频模型）或 agnes-image-*（图像模型），它们没有 chat 接口。
BLENDER_AGENT_BASE_URL=https://openrouter.ai/api/v1
BLENDER_AGENT_API_KEY=sk-or-v1-xxxx
BLENDER_AGENT_MODEL=nvidia/nemotron-3.5-super-vl:free

# Agnes 示例（把上面三行替换为下面三行）：
# BLENDER_AGENT_BASE_URL=https://apihub.agnes-ai.com/v1
# BLENDER_AGENT_API_KEY=sk-xxxx
# BLENDER_AGENT_MODEL=agnes-2.5-flash        # 对话模型（2.5-pro-beta 需余额，实测 $0 不可用）

# Blender MCP 后端
BLENDER_AGENT_MCP_TRANSPORT=stdio          # stdio | http
BLENDER_AGENT_MCP_COMMAND=uvx
BLENDER_AGENT_MCP_ARGS=mcp-for-blender
BLENDER_AGENT_MCP_HTTP_URL=http://127.0.0.1:9765/mcp

# 工作区（.blend 与导出落盘目录）
BLENDER_AGENT_WORKSPACE=./workspace
BLENDER_AGENT_MAX_STEPS=40
